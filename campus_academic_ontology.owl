    <rdfs:comment xml:lang="en">The semester sequence within its academic year.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Person"/>
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Organisation"/>
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Place"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Campus"/>
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Building"/>
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Room"/>
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#OutdoorSpace"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Course"/>
      <rdf:Description rdf:about="https://example.org/hinton/newstudent#Module"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#TeachingBuilding">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Building"/>
    <rdfs:label xml:lang="en">Teaching building</rdfs:label>
    <rdfs:comment xml:lang="en">A building primarily used for lectures, seminars and tutorial teaching.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#LaboratoryBuilding">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Building"/>
    <rdfs:label xml:lang="en">Laboratory building</rdfs:label>
    <rdfs:comment xml:lang="en">A building primarily containing laboratories and practical teaching spaces.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#SportsBuilding">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Building"/>
    <rdfs:label xml:lang="en">Sports building</rdfs:label>
    <rdfs:comment xml:lang="en">A building primarily providing indoor sports and fitness facilities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#SportsHall">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#SportsBuilding"/>
    <rdfs:label xml:lang="en">Sports hall</rdfs:label>
    <rdfs:comment xml:lang="en">A sports building containing indoor sports courts or other indoor sports spaces.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#AdministrationBuilding">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Building"/>
    <rdfs:label xml:lang="en">Administration building</rdfs:label>
    <rdfs:comment xml:lang="en">A building primarily used for university administration.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#StudentResidence">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Building"/>
    <rdfs:label xml:lang="en">Student residence</rdfs:label>
    <rdfs:comment xml:lang="en">A building primarily used as student accommodation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#DiningBuilding">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Building"/>
    <rdfs:label xml:lang="en">Dining building</rdfs:label>
    <rdfs:comment xml:lang="en">A building primarily providing campus dining services.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#TeachingRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Room"/>
    <rdfs:label xml:lang="en">Teaching room</rdfs:label>
    <rdfs:comment xml:lang="en">A room directly used for classroom teaching.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#Classroom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#TeachingRoom"/>
    <rdfs:label xml:lang="en">Classroom</rdfs:label>
    <rdfs:comment xml:lang="en">A room used for regular classroom teaching.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#EngineeringLaboratory">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Laboratory"/>
    <rdfs:label xml:lang="en">Engineering laboratory</rdfs:label>
    <rdfs:comment xml:lang="en">A room used for engineering experiments and equipment-based practical teaching.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#AcademicOffice">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Office"/>
    <rdfs:label xml:lang="en">Academic office</rdfs:label>
    <rdfs:comment xml:lang="en">An office used by academic staff for work or student consultations.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#AdministrativeOffice">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Office"/>
    <rdfs:label xml:lang="en">Administrative office</rdfs:label>
    <rdfs:comment xml:lang="en">An office used by academic administration or other administrative staff.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#SportsRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Room"/>
    <rdfs:label xml:lang="en">Sports room</rdfs:label>
    <rdfs:comment xml:lang="en">A room supporting indoor sports, fitness or associated activities.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#FitnessRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#SportsRoom"/>
    <rdfs:label xml:lang="en">Fitness room</rdfs:label>
    <rdfs:comment xml:lang="en">A room equipped for fitness training.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#IndoorCourt">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#SportsRoom"/>
    <rdfs:label xml:lang="en">Indoor court</rdfs:label>
    <rdfs:comment xml:lang="en">An individually identifiable indoor room used for ball sports in this version.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#ChangingRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#SportsRoom"/>
    <rdfs:label xml:lang="en">Changing room</rdfs:label>
    <rdfs:comment xml:lang="en">A room providing changing facilities for sports activities in this version.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#ReadingRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#StudySpace"/>
    <rdfs:label xml:lang="en">Reading room</rdfs:label>
    <rdfs:comment xml:lang="en">A study room for reading and consulting resources.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#LibraryRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Room"/>
    <rdfs:label xml:lang="en">Library room</rdfs:label>
    <rdfs:comment xml:lang="en">A room located inside a library building; membership can be inferred from its building location.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/hinton/newstudent#Room"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://example.org/hinton/newstudent#locatedInBuilding"/>
            <owl:someValuesFrom rdf:resource="https://example.org/hinton/newstudent#LibraryBuilding"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#LibraryReadingRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#ReadingRoom"/>
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#LibraryRoom"/>
    <rdfs:label xml:lang="en">Library reading room</rdfs:label>
    <rdfs:comment xml:lang="en">A room that is both a reading room and a library room.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/hinton/newstudent#ReadingRoom"/>
          <rdf:Description rdf:about="https://example.org/hinton/newstudent#LibraryRoom"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#BookStackRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#LibraryRoom"/>
    <rdfs:label xml:lang="en">Book stack room</rdfs:label>
    <rdfs:comment xml:lang="en">A library room primarily used to store and organise books and journals.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#LoanServiceRoom">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#LibraryRoom"/>
    <rdfs:label xml:lang="en">Loan service room</rdfs:label>
    <rdfs:comment xml:lang="en">An individually identifiable library room providing borrowing, returns or reader services.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#OutdoorSpace">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#Place"/>
    <rdfs:label xml:lang="en">Outdoor space</rdfs:label>
    <rdfs:comment xml:lang="en">An open-air campus space, distinct from an indoor room or building.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://example.org/hinton/newstudent#locatedOnCampus"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://example.org/hinton/newstudent#Campus"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#SportsGround">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#OutdoorSpace"/>
    <rdfs:label xml:lang="en">Sports ground</rdfs:label>
    <rdfs:comment xml:lang="en">A general outdoor sports area that can contain sports fields or athletics tracks; it is not a building.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#OutdoorCourt">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#OutdoorSpace"/>
    <rdfs:label xml:lang="en">Outdoor court</rdfs:label>
    <rdfs:comment xml:lang="en">An outdoor area used for ball sports such as basketball or tennis.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/hinton/newstudent#CampusSquare">
    <rdfs:subClassOf rdf:resource="https://example.org/hinton/newstudent#OutdoorSpace"/>
    <rdfs:label xml:lang="en">Campus square</rdfs:label>
    <rdfs:comment xml:lang="en">An outdoor square used for gatherings, activities or pedestrian circulation.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/hinton/newstudent#spatiallyPartOf">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#Place"/>
    <rdfs:range rdf:resource="https://example.org/hinton/newstudent#Place"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">Spatially part of</rdfs:label>
    <rdfs:comment xml:lang="en">Transitive physical containment between places. Do not use for organisational membership or OWL cardinality restrictions.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/hinton/newstudent#hasLibraryRoom">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#LibraryBuilding"/>
    <rdfs:range rdf:resource="https://example.org/hinton/newstudent#LibraryRoom"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty>
        <owl:inverseOf rdf:resource="https://example.org/hinton/newstudent#locatedInBuilding"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:label xml:lang="en">Has library room</rdfs:label>
    <rdfs:comment xml:lang="en">A room contained in a library building. This entails that the room is locatedInBuilding that library building.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#libraryServiceURL">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#LibraryBuilding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">Library service URL</rdfs:label>
    <rdfs:comment xml:lang="en">The library service and usage information page.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#spaceName">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#OutdoorSpace"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Space name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of an outdoor space such as a sports ground, track or court.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#spaceCode">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#OutdoorSpace"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Space code</rdfs:label>
    <rdfs:comment xml:lang="en">An identifier distinguishing outdoor spaces.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#surfaceType">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#OutdoorSpace"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Surface type</rdfs:label>
    <rdfs:comment xml:lang="en">The surface material, such as grass, artificial turf or a synthetic sports surface.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#areaSquareMetres">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#Place"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">Area square metres</rdfs:label>
    <rdfs:comment xml:lang="en">The area of a place in square metres. Values must be non-negative; enforce this through data validation.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#openingHoursText">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#Place"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Opening hours text</rdfs:label>
    <rdfs:comment xml:lang="en">Published opening hours for readers; this text alone is not sufficient to compute free booking slots.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#isAccessible">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#Room"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Is accessible</rdfs:label>
    <rdfs:comment xml:lang="en">Whether a wheelchair user can reach the room by a continuous step-free route and enter through a wheelchair-suitable entrance. Missing means unknown. True does not certify all accessibility facilities; a lift or an accessible building entrance alone does not establish this value.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#accessibilityNote">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#Room"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Accessibility note</rdfs:label>
    <rdfs:comment xml:lang="en">Verified details of entrances, routes, lifts, doorway limitations and evidence. This is not a comprehensive accessibility certification.</rdfs:comment>
  </owl:DatatypeProperty>
</rdf:RDF>
