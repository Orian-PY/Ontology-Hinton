    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#Room"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">Has hearing loop</rdfs:label>
