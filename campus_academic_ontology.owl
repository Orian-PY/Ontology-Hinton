    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Opening hours</rdfs:label>
    <rdfs:comment xml:lang="en">Published opening hours; exceptions may need separate maintenance.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#roomName">
    <rdfs:domain rdf:resource="https://example.org/hinton/newstudent#Room"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Room name</rdfs:label>
    <rdfs:comment xml:lang="en">A descriptive room name in addition to roomID and roomNumber.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/hinton/newstudent#roomAreaSquareMetres">
