    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">Safety instructions</rdfs:label>
    <rdfs:comment xml:lang="en">Published laboratory safety instructions.</rdfs:comment>
  </owl:DatatypeProperty>
